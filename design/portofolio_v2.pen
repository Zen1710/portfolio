                {
                  "type": "text",
                  "id": "bcCeB",
                  "name": "About P1",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": 760,
                  "content": "I'm a full-stack developer who likes owning a feature from end to end: shaping the database schema, writing the API, and finishing the interface people actually use.",
