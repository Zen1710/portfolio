                  "type": "text",
                  "id": "zA6NO",
                  "name": "About P2",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": 680,
                  "content": "Most of my projects are built with Next.js and TypeScript. I also build frontends in React, Vue, and SvelteKit, and backends with Node.js and Express, Go, and PostgreSQL.",
                  "lineHeight": 1.65,
                  "fontFamily": "$font",
                  "fontSize": 19,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Z9U6m",
                  "name": "About P3",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": 680,
                  "content": "I'm looking for a full-time or remote role where I can ship real features with a team and keep growing as an engineer.",
                  "lineHeight": 1.65,
                  "fontFamily": "$font",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
